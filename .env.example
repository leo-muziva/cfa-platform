# Supabase — get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Secret (service-role) key — SERVER ONLY, never expose to the browser.
# Needed for the admin "add member" invite flow.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Base URL of this app — used in invite email redirect links.
# Local: http://localhost:3000 · Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email) — Phase 3 only, leave blank for now
# Get from: resend.com → API Keys
RESEND_API_KEY=

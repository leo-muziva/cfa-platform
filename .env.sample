# Safe configuration template. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Online payment checkout is disabled unless the sandbox configuration is complete.
PAYMENT_PROVIDER=payfast_sandbox
PAYFAST_SANDBOX_ENABLED=true
PAYMENT_PUBLIC_ORIGIN=https://your-staging-host.example
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Existing server-only Supabase privileged key is also required for settlement.
SUPABASE_SECRET_KEY=

# Reserved Peach configuration. Existing Peach code is not a verified V2 adapter.
# Switching to Peach requires a compatible adapter and acceptance tests first.
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=
PEACH_WEBHOOK_SECRET=
PEACH_WEBHOOK_URL=
PEACH_AUTH_BASE_URL=https://sandbox-dashboard.peachpayments.com
PEACH_CHECKOUT_BASE_URL=https://testsecure.peachpayments.com
PEACH_LINKS_ENABLED=false
PEACH_LINKS_BASE_URL=https://sandbox-l.ppay.io
PEACH_REFUNDS_ENABLED=false
# PayFast refunds via API. PayFast does not support refunds in sandbox.
PAYFAST_REFUNDS_ENABLED=false
PEACH_SAVED_CARDS_ENABLED=false

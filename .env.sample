# Safe configuration template. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Online payment checkout is disabled unless the sandbox configuration is complete.
PAYMENT_PROVIDER=payfast_sandbox
PAYFAST_SANDBOX_ENABLED=true
PAYMENT_PUBLIC_ORIGIN=https://your-staging-host.example
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Existing server-only Supabase privileged key is also required for settlement.
SUPABASE_SECRET_KEY=
# Membership payment emails through the Resend API. Server-only. EMAIL_FROM
# must be on a domain verified in Resend. Approval still works without these.
RESEND_API_KEY=
EMAIL_FROM=
# Shared secret Vercel Cron sends to /api/cron/* (hold expiry, monthly invoicing).
CRON_SECRET=

# Reserved Peach configuration. Existing Peach code is not a verified V2 adapter.
# Switching to Peach requires a compatible adapter and acceptance tests first.
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=
PEACH_WEBHOOK_SECRET=
PEACH_WEBHOOK_URL=
PEACH_AUTH_BASE_URL=https://sandbox-dashboard.peachpayments.com
PEACH_CHECKOUT_BASE_URL=https://testsecure.peachpayments.com
PEACH_LINKS_ENABLED=false
PEACH_LINKS_BASE_URL=https://sandbox-l.ppay.io
PEACH_REFUNDS_ENABLED=false
# PayFast refunds via API. PayFast does not support refunds in sandbox.
PAYFAST_REFUNDS_ENABLED=false
PEACH_SAVED_CARDS_ENABLED=false

# AI proof for supplier spreadsheets. Server-only; never prefix with NEXT_PUBLIC_.
# Providers are tried in this order and any without a key is skipped. With
# none set, the AI proof runs the basic checks only. Only product data is sent.
# Groq: turn on Zero Data Retention in the Groq console (Data Controls).
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Mistral free plan: turn on the training opt-out.
MISTRAL_API_KEY=
# Optional model overrides (defaults: openai/gpt-oss-120b, gemini-3.5-flash-lite, mistral-small-latest).
GROQ_MODEL=
GEMINI_MODEL=
MISTRAL_MODEL=
# Gmail drafts through Composio. Connect a dedicated ordering mailbox, not a personal one.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
# Optional: the User ID shown next to the connected account. The ca_ ID alone is enough.
COMPOSIO_USER_ID=
# Optional: pin the Composio Gmail toolkit version instead of using the latest.
COMPOSIO_GMAIL_TOOLKIT_VERSION=
# Where the supplier order email goes. Never chosen by the AI.
SUPPLIER_EMAIL=
